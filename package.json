{
  "name": "vidyamargai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend-node"
  ],
  "scripts": {
    "build": "npm run build --workspace=backend-node && npm run build --workspace=frontend",
